# OPTIONAL. The application runs with no configuration at all (the values below are the defaults).
# The application reads real environment variables; it does NOT load this file automatically.
# PowerShell example:   $env:SERVER_PORT = "8081" ; .\run.bat
# Never put real passwords in this file - copy it to .env (git-ignored) if you need your own notes.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=polling_voting_db
SERVER_PORT=8080
# SERVER_HOST=127.0.0.1
